# Copy to .env and adjust. All values are optional — defaults shown.
PORT=8080
NODE_ENV=development

# MongoDB. Docker Compose sets mongodb://mongodb:27017/supervisor
MONGODB_URI=mongodb://localhost:27017/supervisor

# Run without Docker: start an embedded MongoDB persisted in ./.data (npm run dev:local sets this)
USE_MEMORY_DB=false
EMBEDDED_MONGO_PORT=27018
# Skip mongodb-memory-server's binary download (set inside Docker images)
MONGOMS_DISABLE_POSTINSTALL=0

# Live traffic simulator (on | off) and its tick in ms
SIMULATION=on
SIMULATION_TICK_MS=6000

# Request logging (off to silence)
LOG_REQUESTS=on

# Optional. Not required by the mock LLM
QDRANT_URL=http://localhost:6333
OPENAI_API_KEY=sk-dummy-key
TOGETHER_API_KEY=dummy-key
